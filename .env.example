# Ports.
NOVA_HOST=0.0.0.0
NOVA_PORT=8080

# Websocket address
NOVA_PUBLIC_URL=ws://127.0.0.1:8080

# Your backend api key
NOVA_API_KEY=change-me

# generate a JWT key.
NOVA_TICKET_SECRET=change-me-to-a-long-random-string
NOVA_TICKET_TTL_SECONDS=300

# only in development mode
NOVA_ALLOW_UNSIGNED_TICKETS=false

# GS
NOVA_SERVERS=127.0.0.1:7777:playlist_defaultsolo:NAE:100

# Configure for GS
NOVA_READY_CHECK=probe
NOVA_READY_DELAY_SECONDS=3
NOVA_PROBE_INTERVAL_MS=2000

# true keeps players waiting for a server running
NOVA_STRICT_PLAYLIST=true

NOVA_DEFAULT_REGION=NAE
NOVA_DEFAULT_MAX_PLAYERS=100
NOVA_HEARTBEAT_TIMEOUT_SECONDS=30
NOVA_TICK_INTERVAL_MS=1000
NOVA_QUEUE_UPDATE_INTERVAL_MS=5000
NOVA_JOIN_DELAY_SECONDS=1
NOVA_RESERVATION_TTL_SECONDS=60
NOVA_SESSION_TTL_MINUTES=60
NOVA_MAX_QUEUE_SIZE=10000

# Logging
NOVA_LOG_LEVEL=info






## MATCHMAKER GUYS